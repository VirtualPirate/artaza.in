---
import type { Tag } from '../data/portfolio';
interface Props { label: 'projects' | 'articles'; tags?: Tag[] }
const { label, tags = [] } = Astro.props;
---
<div class="paginated-list" data-page-size="4" data-item-label={label}>
  {tags.length > 0 && <div class="project-filters" data-filter-controls hidden>
    <label class="tag-select">
      <span class="tag-select-label">Filter by tag</span>
      <svg class="tag-select-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 17h16M8 4v6M16 14v6" /></svg>
      <select data-tag-filter>
        <option value="" selected>All tags</option>
        {tags.map(tag => <option value={tag.label}>{tag.label}</option>)}
      </select>
      <svg class="tag-select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
    </label>
  </div>}
  <slot />
  <nav class="pagination" aria-label={`${label === 'projects' ? 'Projects' : 'Blog'} pagination`} hidden>
    <button type="button" data-previous>Previous</button>
    <span data-pagination-status role="status" aria-atomic="true"></span>
    <button type="button" data-next>Next</button>
  </nav>
</div>
<script>import '../scripts/lists.js';</script>
