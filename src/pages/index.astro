---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import Tags from '../components/Tags.astro';
import { profile, projects, contributions } from '../data/portfolio';
const selectedProjects = ['devsummary-desktop', 'launchstack'].map(slug => projects.find(project => project.slug === slug)!);
const tauri = contributions[0];
---
<SiteLayout title={`${profile.name} — ${profile.role}`} description={profile.description} active="Home" interactive>
  <main class="shell home" id="main">
    <div class="intro">
      <p class="hello">Hello, I’m</p>
      <h1>{profile.name}<span class="period">.</span></h1>
      <p class="role">{profile.tagline}</p>
      <p class="bio">{profile.bio.join(' ')}</p>
      <div class="hero-actions">
        <a class="primary-button" href="#selected-work">View selected work <span aria-hidden="true">↓</span></a>
        <a class="resume-button" href={profile.resume} download>Download resume <span aria-hidden="true">↓</span></a>
      </div>
      <a class="contribution-proof" href={tauri.href} target="_blank" rel="noopener noreferrer">
        {tauri.logoImage && <Image src={tauri.logoImage} alt="Tauri logo" width={36} height={36} widths={[36, 72]} sizes="36px" format="webp" />}
        <div><strong>Merged in Tauri’s official upload plugin</strong><p>I added upload and download speed reporting in Rust and TypeScript.</p></div>
        <span class="link-arrow" aria-hidden="true">↗</span>
      </a>
      <div class="social-links" aria-label="Find me elsewhere">
        {profile.socials.map(link => <a href={link.href} target={link.href.startsWith('https://') ? '_blank' : undefined} rel={link.href.startsWith('https://') ? 'noopener noreferrer' : undefined}>{link.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
    <section class="selected-work" id="selected-work" aria-labelledby="selected-work-heading">
      <header class="section-heading"><h2 id="selected-work-heading">Selected work</h2><a href="/work/">All work & experience <span aria-hidden="true">→</span></a></header>
      {selectedProjects.map(project => <article class="featured-project">
        <div class="featured-copy">
          <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
          <p>{project.slug === 'devsummary-desktop' ? 'Git activity turned into useful briefs, with the database and credentials stored on your computer.' : 'A TypeScript SaaS foundation with authentication, organizations, roles, and shared API validation.'}</p>
          <Tags tags={project.detailTags} />
          <a class="text-link" href={`/projects/${project.slug}/`}>Explore {project.title} <span aria-hidden="true">→</span></a>
        </div>
        {project.image && <a class="featured-image" href={`/projects/${project.slug}/`} aria-label={`Explore ${project.title}`}>
          <Image src={project.image} alt={project.imageAlt!} widths={[400, 800]} sizes="(max-width: 600px) calc(100vw - 40px), 440px" format="webp" loading="lazy" />
        </a>}
      </article>)}
    </section>
    <div class="home-writing">
      <h2>Notes from building</h2><p>Things I’ve learned about APIs, data, and the web.</p><a class="text-link" href="/blog/">Read the blog <span aria-hidden="true">→</span></a>
    </div>
  </main>
<script>import '../scripts/grid.js';</script>
</SiteLayout>
