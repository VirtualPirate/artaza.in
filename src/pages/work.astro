---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import LinkCard from '../components/LinkCard.astro';
import Icon from '../components/Icon.astro';
import Tags from '../components/Tags.astro';
import { Image } from 'astro:assets';
import PaginatedList from '../components/PaginatedList.astro';
import { profile, about, experience, skillGroups, specialties, education, projects, contributions, repositoryLink } from '../data/portfolio';
const projectTags = [...new Map(projects.flatMap(project => project.tags).map(tag => [tag.label, tag])).values()].sort((a, b) => a.label.localeCompare(b.label));
const categories = [{ id: 'experience', title: 'Experience' }, { id: 'side-products', title: 'Side Projects' }, { id: 'open-source', title: 'Open Source Contributions' }];
---
<SiteLayout title={`Work — ${profile.name}`} description={`${profile.name}’s experience, side projects, and open source contributions.`} active="Work" interactive breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Work', href: '/work/' }]}>
  <main class="shell inner-page" id="main">
    <PageHeading title="Work" description="What I’ve worked on, and what I build for fun." />
    <nav class="work-tabs" aria-label="Work categories">
      {categories.map(category => <a id={`tab-${category.id}`} href={`#${category.id}`}>{category.title}</a>)}
    </nav>
    <section class="work-panel" id="experience" aria-labelledby="tab-experience">
      <h2 class="panel-title">Experience</h2>
      <p class="card-description">{about}</p>
      <div class="work-cards">
        {experience.map(job => <article class="work-card"><div class="card-heading"><span class="card-logo" aria-hidden="true"><Image src={job.logoImage} alt={`${job.company} logo`} width={48} height={48} widths={[48, 96]} sizes="48px" format="webp" loading="lazy" /></span><div><h3>{job.company}</h3><p class="job-role">{job.role}</p><p class="job-date"><time datetime={job.start}>{job.startLabel}</time> — {job.end ? <time datetime={job.end}>{job.endLabel}</time> : job.endLabel}</p></div></div><ul class="card-description achievements">{job.achievements.map(achievement => <li>{achievement}</li>)}</ul></article>)}
      </div>
      <a class="text-link" href={profile.resume} target="_blank" rel="noopener noreferrer">View résumé <span aria-hidden="true">↗</span></a>
      <section class="work-panel" aria-labelledby="skills-heading">
        <h2 id="skills-heading">Skills & focus</h2>
        <p class="card-description">{specialties}</p>
        <article class="work-card">
          {skillGroups.map(group => <div class="card-description"><h3>{group.title}</h3><Tags tags={group.tags} /></div>)}
        </article>
      </section>
      <section class="work-panel" aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <article class="work-card work-panel"><h3>{education.university}</h3><p class="job-role">{education.degree}</p><p class="job-date"><time datetime={education.start}>{education.startLabel}</time> — <time datetime={education.end}>{education.endLabel}</time></p></article>
      </section>
    </section>
    <section class="work-panel" id="side-products" aria-labelledby="tab-side-products">
      <h2 class="panel-title">Side Projects</h2>
      <PaginatedList label="projects" tags={projectTags}>
        <div class="work-cards project-grid" data-list-items>{projects.map(project => <LinkCard {...project} href={`/projects/${project.slug}/`} links={['devsummary', 'papersfly'].includes(project.theme) ? project.links : undefined} />)}</div>
      </PaginatedList>
      <a class="text-link icon-link" href={repositoryLink} target="_blank" rel="noopener noreferrer"><Icon name="github" />More on GitHub <span aria-hidden="true">↗</span></a>
    </section>
    <section class="work-panel" id="open-source" aria-labelledby="tab-open-source">
      <h2 class="panel-title">Open Source Contributions</h2>
      <div class="work-cards">{contributions.map(contribution => <LinkCard {...contribution} />)}</div>
    </section>
  </main>
<script>import '../scripts/grid.js'; import '../scripts/tabs.js';</script>
</SiteLayout>
