---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Tags from '../../components/Tags.astro';
import PaginatedList from '../../components/PaginatedList.astro';
import { profile, linkedInArticles } from '../../data/portfolio';
import { posts, previewPost } from '../../data/posts';
---
<SiteLayout title={`Blog — ${profile.name}`} description={`Notes on programming and building things by ${profile.name}.`} active="Blog" interactive breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }]}>
  <main class="shell inner-page" id="main">
    <PageHeading title="Blog" description="Notes on code and things I’m learning." />
    <PaginatedList label="articles">
      <div class="work-cards blog-list" data-list-items>
        {linkedInArticles.map(article => <a class="work-card blog-entry" href={article.href} target="_blank" rel="noopener noreferrer"><span class="entry-meta">Published on LinkedIn</span><h2>{article.title}</h2><p class="card-description">{article.description}</p><div class="blog-entry-footer"><Tags tags={article.tags} /><span class="blog-read">Read on LinkedIn <span class="link-arrow" aria-hidden="true">↗</span></span></div></a>)}
        {posts.filter(post => !post.frontmatter.preview).map(post => <a class="work-card blog-entry" href={post.href}><time class="entry-meta" datetime={post.frontmatter.date}>{post.frontmatter.dateLabel}</time><h2>{post.frontmatter.title}</h2><p class="card-description">{post.frontmatter.description}</p><div class="blog-entry-footer"><Tags tags={post.frontmatter.tags} /><span class="blog-read">Read article <span class="link-arrow" aria-hidden="true">↗</span></span></div></a>)}
      </div>
    </PaginatedList>
    <a class="text-link" href={previewPost.href}>Preview a blog post <span aria-hidden="true">→</span></a>
  </main>
<script>import '../../scripts/grid.js';</script>
</SiteLayout>
